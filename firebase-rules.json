{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "artists": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'hXvvFNdMvyOMihZVI7WXgVE9wqP2'"
    },
    "trendw": {
      "$week": {
        ".read": true,
        ".indexOn": ["s"],
        "$sid": {
          ".write": "auth != null && newData.exists()",
          ".validate": "newData.hasChildren(['s','t','a','i'])",
          "s": { ".validate": "newData.isNumber() && newData.val() - (data.exists() ? data.val() : 0) >= 1 && newData.val() - (data.exists() ? data.val() : 0) <= 90" },
          "t": { ".validate": "newData.isString() && newData.val().length <= 150" },
          "a": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "i": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "$other": { ".validate": false }
        }
      }
    },
    "playlists": {
      ".read": true,
      ".indexOn": ["u", "nl"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('o').val() === auth.uid) || (data.exists() && (data.child('o').val() === auth.uid || auth.uid === 'hXvvFNdMvyOMihZVI7WXgVE9wqP2')))",
        ".validate": "newData.hasChildren(['n','nl','o','on','u','pc','s'])",
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "nl": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "d": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "o": { ".validate": "newData.val() === (data.exists() ? data.val() : auth.uid)" },
        "on": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "u": { ".validate": "newData.val() === now" },
        "pc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "c": {
          ".validate": "newData.numChildren() <= 4",
          "$i": { ".validate": "newData.isString() && newData.val().length <= 300" }
        },
        "x": {
          ".validate": "newData.numChildren() <= 6",
          "$i": { ".validate": "newData.isString() && newData.val().length <= 100" }
        },
        "s": {
          ".validate": "newData.numChildren() <= 100",
          "$k": {
            ".validate": "newData.hasChildren(['i','t','a','m','d'])",
            "i": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "t": { ".validate": "newData.isString() && newData.val().length <= 150" },
            "a": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "d": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "pubIdx": {
      "$a": {
        ".read": true,
        "$id": {
          ".write": "auth != null && (newData.val() === auth.uid || data.val() === auth.uid || auth.uid === 'hXvvFNdMvyOMihZVI7WXgVE9wqP2')",
          ".validate": "newData.isString() && newData.val().length <= 100"
        }
      }
    },
    "reports": {
      "$id": {
        ".read": "auth != null && auth.uid === 'hXvvFNdMvyOMihZVI7WXgVE9wqP2'",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid",
          ".validate": "newData.val() === 1"
        }
      }
    }
  }
}
